{
  "expo": {
    "name": "SparkXP",
    "slug": "englishxp",
    "scheme": "englishxp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoSparkXP.webp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usukh6ayar.englishxp",
      "infoPlist": {
        "NSCameraUsageDescription": "Анги нэгдэх QR код уншихад камер ашиглана.",
        "NSMicrophoneUsageDescription": "AI Buddy-тай дуут яриа хийхэд микрофон ашиглана.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.usukh6ayar.englishxp",
      "adaptiveIcon": {
        "backgroundColor": "#191040",
        "foregroundImage": "./assets/logoSparkXP.webp"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/logoSparkXP.webp"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Анги нэгдэх QR код уншихад камер ашиглана."
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset",
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      "expo-font"
    ],
    "owner": "usukh6ayar",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5b190dd-0fb6-4684-8aff-4648fb0f0357"
      }
    }
  }
}
