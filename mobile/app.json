{
  "expo": {
    "name": "SparkXP",
    "slug": "sparkxp",
    "scheme": "sparkxp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mn.app.sparkxp",
      "icon": "./assets/icon-ios.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Анги нэгдэх QR код уншихад камер ашиглана.",
        "NSMicrophoneUsageDescription": "AI Buddy-тай дуут яриа хийхэд микрофон ашиглана.",
        "NSFaceIDUsageDescription": "Апп-ыг Face ID-аар түгжиж хамгаалахад ашиглана.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "mn.app.sparkxp",
      "adaptiveIcon": {
        "backgroundColor": "#191040",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FD",
          "dark": {
            "backgroundColor": "#0B0716"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Анги нэгдэх QR код уншихад камер ашиглана."
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset",
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID ашиглан хурдан бөгөөд аюулгүй нэвтрэх."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C3BFF"
        }
      ],
      [
        "@sentry/react-native",
        {
          "organization": "REPLACE_WITH_SENTRY_ORG_SLUG",
          "project": "REPLACE_WITH_SENTRY_PROJECT_SLUG",
          "url": "https://sentry.io/"
        }
      ],
      "expo-localization"
    ],
    "owner": "usukh6ayar",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "302d838f-49f9-4abe-8179-d3d180940fe7"
      }
    }
  }
}
