{
  "expo": {
    "name": "SparkXP",
    "slug": "englishxp",
    "scheme": "englishxp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.usukh6ayar.englishxp",
      "icon": "./assets/icon-ios.png",
      "infoPlist": {
        "NSCameraUsageDescription": "\u0410\u043d\u0433\u0438 \u043d\u044d\u0433\u0434\u044d\u0445 QR \u043a\u043e\u0434 \u0443\u043d\u0448\u0438\u0445\u0430\u0434 \u043a\u0430\u043c\u0435\u0440 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430.",
        "NSMicrophoneUsageDescription": "AI Buddy-\u0442\u0430\u0439 \u0434\u0443\u0443\u0442 \u044f\u0440\u0438\u0430 \u0445\u0438\u0439\u0445\u044d\u0434 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430.",
        "NSFaceIDUsageDescription": "\u0410\u043f\u043f-\u044b\u0433 Face ID-\u0430\u0430\u0440 \u0442\u04af\u0433\u0436\u0438\u0436 \u0445\u0430\u043c\u0433\u0430\u0430\u043b\u0430\u0445\u0430\u0434 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.usukh6ayar.englishxp",
      "adaptiveIcon": {
        "backgroundColor": "#191040",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FD",
          "dark": {
            "backgroundColor": "#0B0716"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "\u0410\u043d\u0433\u0438 \u043d\u044d\u0433\u0434\u044d\u0445 QR \u043a\u043e\u0434 \u0443\u043d\u0448\u0438\u0445\u0430\u0434 \u043a\u0430\u043c\u0435\u0440 \u0430\u0448\u0438\u0433\u043b\u0430\u043d\u0430."
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset",
      [
        "@hot-updater/react-native",
        {
          "channel": "production"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID \u0430\u0448\u0438\u0433\u043b\u0430\u043d \u0445\u0443\u0440\u0434\u0430\u043d \u0431\u04e9\u0433\u04e9\u04e9\u0434 \u0430\u044e\u0443\u043b\u0433\u04af\u0439 \u043d\u044d\u0432\u0442\u0440\u044d\u0445."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6C3BFF"
        }
      ]
    ],
    "owner": "usukh6ayar",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5b190dd-0fb6-4684-8aff-4648fb0f0357"
      }
    }
  }
}
