# === Backend API base URL (EXPO_PUBLIC_ → read in the app at runtime) ===
#
# ⚠️ Real phone + your Mac must be on the SAME network.
#    If the IP changes (new router/network), update it here and restart Expo (-c).
#    A wrong IP makes the phone hang / feel "very slow" (request timeout).
#
#  • LAN (ethernet/cable):  ifconfig | grep "inet " | grep -v 127.0.0.1
#  • WiFi:                  ipconfig getifaddr en0
#  • Simulator / web only:  localhost works.

# LOCAL / TEST backend (Mac + local Postgres = test data). Phone → Mac's IP:
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api   # ← put YOUR Mac's IP here
# EXPO_PUBLIC_API_URL=http://localhost:3000/api      # simulator / web only
#
# REAL / PROD backend (Railway, deployed = real data). Each backend has its own
# DB — local & prod data are NOT shared. Easiest for Choi/Boju (works from any
# network, no need for the lead's Mac to be on):
# EXPO_PUBLIC_API_URL=https://sparkxp-production.up.railway.app/api

# === Hot Updater OTA (Cloudflare Worker base URL, no trailing slash) ===
# Only used in native builds (expo run / EAS) — ignored in Expo Go.
# After `npx hot-updater init` (Cloudflare), paste the Worker URL here:
# EXPO_PUBLIC_HOT_UPDATER_URL=https://sparkxp-hot-updater.<subdomain>.workers.dev
# Deploy secrets live in `.env.hotupdater` (see `.env.hotupdater.example`).

# ============================================================================
# Observability — Sentry (crash/error + performance) · PostHog (analytics)
# ============================================================================
# Both are OFF unless the key below is set, so you can leave this whole block
# commented out and the app behaves exactly as before. Nothing here is a
# secret in the usual sense (they ship inside the app bundle), but keep them
# out of git anyway so test traffic doesn't land in the production projects.

# --- Sentry ---------------------------------------------------------------
# From Sentry → Project Settings → Client Keys (DSN).
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
#
# Share of sessions that get a performance trace in production (0–1).
# 0.2 = 20%. Raise while investigating, lower to cut cost. Default 0.2.
# EXPO_PUBLIC_SENTRY_TRACES_RATE=0.2
#
# Report from a DEV build too. Off by default so local crashes don't bury the
# real production ones.
# EXPO_PUBLIC_MONITORING_IN_DEV=1

# --- PostHog --------------------------------------------------------------
# From PostHog → Project Settings → Project API Key ("phc_...").
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Cloud region. Default is US; use https://eu.i.posthog.com for an EU project.
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Send analytics from a DEV build too (off by default — local clicking around
# would otherwise skew the product numbers).
# EXPO_PUBLIC_ANALYTICS_IN_DEV=1

# NOTE — source maps: `app.json` → plugins → "@sentry/react-native" still has
# REPLACE_WITH_SENTRY_ORG_SLUG / REPLACE_WITH_SENTRY_PROJECT_SLUG placeholders.
# Fill them in, then add SENTRY_AUTH_TOKEN as a *sensitive* EAS environment
# variable (`eas env:create`) — NOT here, it is a real secret. Without it the
# build still succeeds; stack traces just stay minified.
