# Hot Updater (OTA) — Cloudflare R2 + D1 + Worker
# Copy to `.env.hotupdater` and fill in (never commit real secrets).
# Or generate via: npx hot-updater init  (pick Cloudflare)
#
# Docs: https://hot-updater.dev/docs/managed/cloudflare

# SparkXP defaults (already provisioned 2026-07-14) — only FILL secrets:
HOT_UPDATER_CLOUDFLARE_ACCOUNT_ID=353f980624a9cc22818fc9d70762bef2
HOT_UPDATER_CLOUDFLARE_R2_BUCKET_NAME=sparkxp-hot-updater
HOT_UPDATER_CLOUDFLARE_R2_ACCESS_KEY_ID=          # R2 → Manage R2 API Tokens
HOT_UPDATER_CLOUDFLARE_R2_SECRET_ACCESS_KEY=      # same
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_ID=14402c87-ccfa-4e2f-a2b0-5f697f18bf2a
HOT_UPDATER_CLOUDFLARE_API_TOKEN=                 # Account API Token, D1 Edit
HOT_UPDATER_CLOUDFLARE_WORKER_NAME=sparkxp-hot-updater

# App runtime (mobile/.env):
# EXPO_PUBLIC_HOT_UPDATER_URL=https://sparkxp-hot-updater.sparkxp.workers.dev
