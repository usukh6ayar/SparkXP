# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
# Cloud hosts (Railway / Neon / Render) give ONE connection string — set it
# here and the DB_HOST/PORT/... below are ignored. On Railway, reference the
# Postgres plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Local dev (used only when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sparkxp
# Auto-create schema from entities. Use ONLY in development.
# In PRODUCTION set this to false and use migrations instead (see below).
DB_SYNCHRONIZE=true
# Production: set DB_SYNCHRONIZE=false and DB_MIGRATIONS_RUN=true so pending
# SQL migrations run automatically on boot. (You can also run them by hand:
# `npm run migration:run`.) Keep false in dev where synchronize is on.
DB_MIGRATIONS_RUN=false
DB_LOGGING=false
# Set to true when using cloud PostgreSQL (Neon, Supabase, etc.)
# On Railway's INTERNAL network (postgres.railway.internal) SSL is not needed —
# turning it off removes a TLS handshake from every new connection.
DB_SSL=false
# Connection pool (node-postgres). Defaults are fine; raise DB_POOL_MAX only if
# you see "connection timeout" under load, and keep max x replicas < 100.
# DB_POOL_MIN keeps warm connections so requests never pay a reconnect.
DB_POOL_MAX=20
DB_POOL_MIN=2

# --- Redis (cache / queue) ---
# Local: use REDIS_HOST + REDIS_PORT
# Cloud (Upstash / Railway): use REDIS_URL instead.
# On Railway: REDIS_URL=${{Redis.REDIS_URL}}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:password@host:port

# --- Auth (JWT) — used in later phases ---
# REQUIRED in production — boot FAILS if missing, still 'change-me', or <16 chars.
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- First super-admin (bootstrap) ---
# The `BootstrapPlansAdmin` migration creates ONE super_admin account, and only
# when BOTH of these are set — otherwise it skips that step, so a fresh prod DB
# ends up with no way in. Set them BEFORE the first migration run, then remove
# them (leaving a password in the environment is not worth the convenience).
# Re-running the migration with a different email does NOT create a second admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (OTP verify + password reset) ---
# Provider is auto-selected: RESEND_API_KEY first, else SMTP_HOST, else a dev
# stub that just logs the code. Set one of these to send real email.
#
# ⚠️ In PRODUCTION the app REFUSES TO BOOT with neither set — registration
#    cannot complete without the emailed code, and a silent stub would mean
#    every signup dead-ends while the codes sit in the server logs.
#
# Verify it actually works before trusting it:
#    npm run test:email -- you@example.com
# Check SPAM as well as the inbox — a code in spam is a lost user.
#
# No domain? Use BREVO_API_KEY — verify your Gmail as a sender, no domain
# needed, and it is HTTPS so Railway's SMTP block does not apply.
# ⚠️ RAILWAY: outbound SMTP (25/465/587) is BLOCKED below the Pro plan, so the
#    SMTP options below hang in production even when they work locally. Use an
#    HTTPS provider there.
#
# Option A — Brevo (https://brevo.com). HTTPS API, 300/day free, and the only
# one that sends to ANY recipient without owning a domain (verify your sender
# address by email instead). Set MAIL_FROM to that verified address.
BREVO_API_KEY=
#
# Option B — Resend (https://resend.com). HTTPS API, 3,000/month.
# ⚠️ Without a verified DOMAIN it only delivers to the Resend account owner's
#    own address — real users get nothing.
RESEND_API_KEY=
# Option C — any SMTP server (Gmail, etc.). Local dev only on Railway Hobby:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address for outgoing mail (must be a verified sender on your provider):
MAIL_FROM=SparkXP <onboarding@resend.dev>

# --- AI ---
# Word "AI fill" (text fields) uses Google Gemini. Get a key at
# https://aistudio.google.com/apikey (free tier works for dev):
GEMINI_API_KEY=
# Needs a billing-enabled project key. gemini-2.5-flash = cheap/fast (good
# default); gemini-3.1-pro-preview = higher quality, pricier/slower.
GEMINI_MODEL=gemini-2.5-flash
# Max English words per ai-bulk (file) import request (Gemini fills the rest).
AI_BULK_MAX_WORDS=1000
# AI chat buddy still uses Anthropic (Claude):
ANTHROPIC_API_KEY=sk-ant-...
# Vocabulary images = OpenAI directly (gpt-image-2). Needs a billing-enabled
# key. NOTE: GPT Image models require API "Organization Verification" in the
# OpenAI dashboard first, else requests fail. quality=low + 1024x1024 = cheapest.
OPENAI_API_KEY=sk-proj-...
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1024
# Retry count for 429 throttle / transient 5xx (exponential backoff).
OPENAI_IMAGE_MAX_RETRIES=5
# Bulk live queue pacing (existing words → "Зураг үүсгэх"):
#   safe = 1 req/sec · normal = 5 req/sec · low = 1 req/10s
IMAGE_RATE_MODE=normal
# Optional: override the IMAGE_RATE_MODE preset explicitly (batch size + gap
# between batches, ms). Empty = derive from the mode above (normal = 5 / 1000ms).
OPENAI_IMAGE_BATCH=
OPENAI_IMAGE_BATCH_INTERVAL_MS=

# --- OpenAI Batch API (cheapest bulk images; async) ---
# For big runs (e.g. 20k words) the OpenAI Batch API is ~50% cheaper than live,
# async (submit → poll → ingest). gpt-image-1-mini = cheapest. Uses OPENAI_API_KEY.
OPENAI_BATCH_IMAGE_MODEL=gpt-image-2
OPENAI_BATCH_IMAGE_SIZE=1024x1024
OPENAI_BATCH_IMAGE_QUALITY=low
# Max words per single batch submit. OpenAI caps enqueued tokens per org
# (gpt-image-2 = 1M ≈ ~800 of our long-prompt images). Raise as your tier grows.
OPENAI_BATCH_MAX_WORDS=800
# Hands-off server queue: words per chunk the cron submits at a time. The cron
# (every minute) submits one chunk, waits for it, ingests, then the next — so big
# runs finish on the server even with the admin's PC off. Keep small: the batch
# OUTPUT file is ~(chunk × 1MB), and ingesting it on a small (~512MB) container
# can OOM. 100 ≈ 30MB output. Raise only if the container has more memory.
IMAGE_BATCH_CHUNK=100
# Optional: override the whole image prompt (placeholders: {word}, {meaning},
# {example_sentence}, {part_of_speech}, {cefr}). Empty = built-in default style.
IMAGE_PROMPT_TEMPLATE=
# Same idea for idiom illustrations (placeholders: {phrase}, {meaning},
# {example_sentence}). Empty = built-in default idiom prompt.
IDIOM_IMAGE_PROMPT_TEMPLATE=

# --- Pronunciation audio (ElevenLabs TTS) ---
# Without ELEVENLABS_API_KEY the "Audio үүсгэх" feature is disabled (manual
# upload + device TTS still work). Voice/model are optional overrides.
ELEVENLABS_API_KEY=
# Use a PREMADE voice id (free tier). Library/cloned voices need a paid plan.
# Sarah=EXAVITQu4vr4xnSDxMaL, George=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
# (Audio folder is set once under "Generated media storage" below.)

# --- AI Buddy (voice speaking companion) ---
# Provider selection is config-driven (adapters live in ai-gateway/providers).
# Defaults match the current vendors; STT uses ElevenLabs Scribe.
STT_PROVIDER=elevenlabs
# LLM_PROVIDER: anthropic (Claude, default) | openai (GPT, JSON mode)
LLM_PROVIDER=anthropic
TTS_PROVIDER=elevenlabs
# LLM model for the buddy adapter. Empty = claude-haiku-4-5 (fast + cheap chat).
# Only used when LLM_PROVIDER=anthropic.
AI_MODEL=
# OpenAI chat model — only used when LLM_PROVIDER=openai. Empty = gpt-4o-mini.
# Set the exact model id from OpenAI's API (e.g. gpt-5.5, gpt-4o-mini).
OPENAI_LLM_MODEL=
# Reasoning effort for reasoning models (gpt-5.x/o-series): none|low|medium|high|xhigh.
# Leave EMPTY for gpt-4o (which rejects it). For buddy chat use 'low' or 'none'
# (fast + cheap; reasoning tokens are billed as output).
OPENAI_REASONING_EFFORT=
# Privacy: raw uploaded audio is NOT stored by default (in-memory only).
AI_BUDDY_LOG_RAW_AUDIO=false
AI_BUDDY_AUDIO_RETENTION_DAYS=0
# NOTE: reply length, CEFR default, STT confidence threshold, daily voice-turn
# cap live in the Redis limits blob (ai:limits:default) — admin-tunable at
# runtime via PATCH /ai/limits, not env.

# --- Generated media storage ---
# Production: set Cloudinary credentials so generated word images are persistent.
# If omitted, generated images are saved locally under /uploads/generated (dev only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ⚠️ Despite the CLOUDINARY_ names, these are the folder (key prefix) for
# WHICHEVER backend stores the file — and once R2 is configured that is R2, not
# Cloudinary (see image-storage.service.ts storeMedia). Keep them in sync with
# the bucket layout in docs/INFRA_COST_MODEL.md, or new uploads scatter.
CLOUDINARY_FOLDER=words/img
CLOUDINARY_AUDIO_FOLDER=words/audio
CLOUDINARY_WORD_IMAGES_FOLDER=words/img
# Per-type prefixes. The defaults in code already match the bucket layout, so
# these only need setting if you deliberately move something.
IDIOM_IMAGES_FOLDER=idioms/img
IDIOM_AUDIO_FOLDER=idioms/audio
READING_AUDIO_FOLDER=reading/audio
R2_FOLDER=buddy/models
# Used by local fallback URLs, e.g. https://api.sparkxp.mn
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000
# Secondary fallback for the same local-file URL (used only if
# PUBLIC_UPLOAD_BASE_URL is empty). Usually leave blank.
APP_PUBLIC_URL=

# --- Cloudflare R2 (S3-compatible object storage) ---
# When these are set, R2 stores EVERYTHING — images, audio and GLB models alike
# (storeMedia falls back to Cloudinary only when R2 is unconfigured). If any are
# empty, uploads fall back to the local uploads/ folder.
# R2_ENDPOINT = https://<ACCOUNT_ID>.r2.cloudflarestorage.com (R2 → Manage API tokens)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public delivery base for every stored asset (media + trophy images).
# Dev:  the bucket's r2.dev subdomain, e.g. https://pub-xxxxxxxx.r2.dev
#       (enable "Public Development URL" on the bucket first)
# PROD: a CONNECTED CUSTOM DOMAIN, e.g. https://cdn.example.com
#       r2.dev is rate limited (429 at hundreds of req/s), throttles bandwidth
#       and gets NO Cloudflare cache/WAF — Cloudflare states it is for
#       development only. See docs/INFRA_COST_MODEL.md §12c.
R2_PUBLIC_BASE_URL=
# (R2_FOLDER — the GLB/model prefix — is set under "Generated media storage".)
# When R2 is configured, generated images are stored on R2 as a resized WebP of
# this max width (px) — R2 has no on-the-fly resize. Empty = 512.
IMG_WIDTH=
# One-off backfill scripts only (`src/scripts/backfill-media-to-r2.ts`,
# `migrate-images-to-r2.ts`): how many files to copy in parallel. Empty = 16,
# which turns a ~10h sequential run into ~30–45 min. Lower it if the source
# host starts throttling.
BACKFILL_CONCURRENCY=

# --- CORS (production) ---
# Set to your deployed admin Vercel URL e.g. https://sparkxp-admin.vercel.app
ADMIN_ORIGIN=
BASE_URL=http://localhost:3000

# --- Error monitoring (optional) ---
# Leave EMPTY to disable: Sentry is fully inert without a DSN, so nobody needs
# a Sentry account to run the project.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Payments / QPay ---
# MUST stay unset (or "false") until QPay is genuinely integrated.
#
# `POST /payments/:id/confirm` marks a payment PAID and hands out a
# subscription plan or Sparks WITHOUT verifying anything with QPay, and it is
# reachable by any logged-in user. Setting this to "true" therefore gives away
# free premium — see src/payments/guards/payments-enabled.guard.ts.
#
# Before turning it on, `confirm` has to become a signature-verified QPay
# server-to-server callback; the app should only poll payment status.
PAYMENTS_ENABLED=false

# --- Free-lesson quota (3 хичээл) ---
# A free-tier student may open 3 lessons of their own choosing, for the lifetime
# of the account. After that they need a subscription — a plan opens every lesson.
#
# ⚠️ MUST stay false until QPay works. With PAYMENTS_ENABLED=false there is no
# way to actually take the money, so turning this on would lock students out of
# a paywall they cannot pay past.
#
# NEVER counted against the quota: teacher-assigned homework, and every lesson
# a user had already completed before the quota shipped (backfilled as
# `legacy` by AddLessonUnlockSource1787700000000).
#
# Exercises, Soril, Reading, Idioms, Dictionary and SRS review stay free
# regardless — the quota is lessons only.
#
# Fail-closed: only the exact string 'true' enables it.
FREE_LESSON_QUOTA_ENABLED=false

# --- AI Buddy ---
# Owner's decision (2026-08-17): AI Buddy is OPEN.
#
# ⚠️ This is deliberately open WHILE PAYMENTS_ENABLED is still false, which the
# earlier launch decision (2026-08-08) advised against. A buddy turn bills
# ElevenLabs (STT + TTS) and Anthropic (LLM) per call, and with payments off
# nobody can be charged — so every turn is spend the owner absorbs. The only
# ceiling is the per-plan limit blob (`ai:limits:default` in Redis), and the
# FREE tier's limits are the loosest of all. Watch the provider dashboards, and
# tighten the free-tier daily turn cap before opening this to a wide audience.
#
# Gated: POST /ai/chat, /ai/buddy/sessions/:id/turn/{audio,text},
#        /ai/buddy/rt/turn/{text,audio/:sessionId}
# NOT gated: read-only routes (GET usage/statistics/memory — the "Миний багц"
#        screen needs them), admin test-voice (so the owner can verify TTS
#        creds first), and the AI dictionary (cheap + cached forever).
#
# Flipping this needs NO app update either way: the app polls
# GET /ai/buddy/availability and swaps its "Тун удахгүй" screen for the real tab
# on next launch — so setting it back to `false` is the instant kill switch if
# costs run away.
AI_BUDDY_ENABLED=true

# --- Google / Apple sign-in ---
# Comma-separated CLIENT IDs we accept as the `aud` claim of an identity token.
# Leave EMPTY to switch a provider off: `GET /auth/social/providers` then reports
# it as unavailable and the app hides the button — no app update needed.
#
# ⚠️ These are the audience allow-list, i.e. the security boundary. A token
# minted for someone else's app must not be accepted here, so list ONLY the
# client ids belonging to SparkXP.
#
# GOOGLE_CLIENT_IDS: one per platform from Google Cloud Console → Credentials.
#   iOS client id, Android client id, and the Web client id if you use one.
#   e.g. 1234-ios.apps.googleusercontent.com,1234-android.apps.googleusercontent.com
GOOGLE_CLIENT_IDS=
#
# APPLE_CLIENT_IDS: for native Sign in with Apple this is the app's BUNDLE ID
#   (mn.app.sparkxp). A Services ID is only needed for web sign-in.
APPLE_CLIENT_IDS=
